# Zelo - Configurações de Ambiente
PORT=3000

# Chave de API do Google Gemini (obtenha em https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=sua_chave_gemini_aqui

# Modelo estável e de alta velocidade com suporte a Function Calling no Google AI Studio
GEMINI_MODEL=gemini-3.1-flash-lite

# PostgreSQL (opcional localmente — no Docker Compose é configurado automaticamente)
# DATABASE_URL=postgresql://zelo:zelo_pass@localhost:5432/zelo
